# ─────────────────────────────────────────────────────────────
# MongoDB Editor — environment variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# Core MongoDB connection (database: workflowbuilder_core / workflowbuilder_auth).
# Local example:  mongodb://127.0.0.1:27017
# Atlas example:  mongodb+srv://user:pass@cluster.xxxxx.mongodb.net
MONGO_LOCAL_URI=

# Secret used to sign JWT auth tokens. Use a long random string.
# Generate:  openssl rand -hex 32
JWT_SECRET=

# 32-byte key (64 hex chars) for AES-256-CBC encryption of per-room MongoDB URIs.
# Generate:  openssl rand -hex 32
ROOM_SECRET=

# ─────────────────────────────────────────────────────────────
# OAuth — optional. Leave blank to disable a provider's button
# (the app falls back to /login?error=oauth_not_configured).
#
# Authorized redirect / callback URLs to register with each provider:
#   http://localhost:3000/api/auth/oauth/google/callback   (dev)
#   https://YOUR_DOMAIN/api/auth/oauth/google/callback      (prod)
#   http://localhost:3000/api/auth/oauth/github/callback    (dev)
#   https://YOUR_DOMAIN/api/auth/oauth/github/callback       (prod)
# ─────────────────────────────────────────────────────────────

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps
# (GitHub allows one callback URL per app — use a separate app per environment)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
